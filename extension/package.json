{
  "name": "klaxon-browser-extension",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:content": "vite build --watch",
    "dev:service": "vite build --watch -c vite.config.background.ts",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "BROWSER=chrome vite build && BROWSER=chrome vite build -c vite.config.background.ts",
    "build:firefox": "BROWSER=firefox vite build && BROWSER=firefox vite build -c vite.config.background.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "redirect-uris": "node scripts/redirect-uris.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lucide/svelte": "^1.3.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/chrome": "^0.1.40",
    "@types/node": "^22.19.21",
    "globals": "^17.3.0",
    "happy-dom": "^20.7.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.51.0",
    "svelte-check": "^4.3.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
