# Klaxon Cloud web app — server-side configuration.
#
# In production these are Cloudflare Worker secrets/vars (set with
# `wrangler secret put NAME`); locally, copy this file to `.env`.
# Read at runtime via $env/dynamic/private — NOT baked in at build time.

# MuckRock Accounts (Squarelet) OIDC host.
MUCKROCK_ACCOUNTS_HOST="https://dev.squarelet.com/"

# OIDC public client registered for the WEB APP (PKCE, no secret). This is a
# DIFFERENT client from the browser extension's — it has its own redirect URI.
# Register `${MUCKROCK_PUBLIC_ORIGIN}/auth/callback` verbatim on this client,
# plus `${MUCKROCK_PUBLIC_ORIGIN}/` as a post-logout redirect URI.
MUCKROCK_WEB_CLIENT_ID=""

# OAuth scopes requested at sign-in.
MUCKROCK_SCOPES="openid profile email uuid organizations"

# DocumentCloud API base (Klaxon is a DocumentCloud add-on).
MUCKROCK_DOCUMENTCLOUD_API="https://api.www.documentcloud.org/api/"

# Klaxon add-on's numeric id in DocumentCloud (changes between environments).
MUCKROCK_KLAXON_ID=""

# Canonical public origin of this web app, e.g. https://klaxon.muckrock.com
# Used to build the OAuth redirect_uri — must match what's registered on the
# OIDC client exactly (scheme + host, no trailing slash).
MUCKROCK_PUBLIC_ORIGIN="http://localhost:5173"

# Secret used to encrypt the session cookie (A256GCM). Generate with:
#   openssl rand -base64 32
# Rotating this invalidates all existing sessions.
MUCKROCK_SESSION_SECRET=""

# Sentry error reporting (issue #110). DSN comes from the "Klaxon Cloud" (site)
# Sentry project — safe to embed (Sentry DSNs are designed to be public). Baked
# at build time via $env/static/public; leave blank to disable Sentry entirely.
# In Cloudflare Workers Builds, set PUBLIC_MUCKROCK_SENTRY_DSN under Settings →
# Build → Environment variables (one value for all deploys — environment
# tagging separates prod/preview in Sentry's UI).
#
# Deploy environment is derived at build time from WORKERS_CI_BRANCH — see the
# `deployEnvironment()` helper in vite.config.ts. main → production, any other
# branch → staging, unset (local build) → development.
PUBLIC_MUCKROCK_SENTRY_DSN=""
